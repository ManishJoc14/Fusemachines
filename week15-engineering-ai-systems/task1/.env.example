# Application
APP_NAME=Engineering AI Assistant
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_API_V1_PREFIX=/api/v1
CORS_ORIGINS='["http://localhost:3000"]'

# Hosted LLM through Hugging Face Inference Providers
LLM_BACKEND=huggingface
HF_TOKEN=replace-with-your-hugging-face-token
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=openai/gpt-oss-20b:groq
HF_FALLBACK_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731:deepinfra

# OpenAI-compatible local model server.
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=local-only
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Generation controls.
LLM_TEMPERATURE=0.2
LLM_TOP_P=1.0
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOOL_ITERATIONS=5

# Local embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=384

# Hosted Qdrant Cloud vector database
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io:6333
QDRANT_API_KEY=replace-with-your-qdrant-api-key
QDRANT_COLLECTION=assistant_documents

# RAG retrieval and character-based chunking
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_RETRIEVAL_TOP_K=5
RAG_SCORE_THRESHOLD=0.25

# Document ingestion
DOCUMENTS_DIRECTORY=data/documents
MAX_UPLOAD_SIZE_MB=10
